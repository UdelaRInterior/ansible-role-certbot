# {{ ansible_managed }}
# RFC 2136 DNS credentials for Certbot DNS-01 challenge.

# Target DNS server (IPv4 or IPv6 address, not a hostname)
dns_rfc2136_server = {{ certbot_dns_rfc2136_server }}
# Target DNS port
dns_rfc2136_port = {{ certbot_dns_rfc2136_port }}
# TSIG key name
dns_rfc2136_name = {{ certbot_dns_rfc2136_name }}
# TSIG key secret
dns_rfc2136_secret = {{ certbot_dns_rfc2136_secret }}
# TSIG key algorithm
dns_rfc2136_algorithm = {{ certbot_dns_rfc2136_algorithm }}
# TSIG sign SOA query
dns_rfc2136_sign_query = {{ certbot_dns_rfc2136_sign_query | lower }}
